# Service systemd — Nutriform
# À copier dans /etc/systemd/system/nutriform.service puis :
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nutriform
# Journaux : journalctl -u nutriform -f
[Unit]
Description=Nutriform - suivi nutritionnel
After=network.target

[Service]
Type=simple
User=nutriform
Group=nutriform
WorkingDirectory=/opt/nutriform
Environment=NF_DB=/opt/nutriform/data/nutriform.db
Environment=NF_HOST=127.0.0.1
Environment=NF_PORT=5001
Environment=PYTHONUTF8=1
# Pas de NF_PASSWORD : l'authentification est par compte nominatif depuis la
# V2. Les comptes se créent avec tools/gerer_comptes.py (voir DEPLOY.md).
# NE JAMAIS définir NF_PERSONNE_DEFAUT ici : cela court-circuiterait l'écran
# de connexion et donnerait le compte visé à n'importe quel visiteur.
# Clé de signature des cookies de session :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
Environment=NF_SECRET=A_REMPLACER_PAR_UNE_CLE_ALEATOIRE
ExecStart=/opt/nutriform/.venv/bin/python serve.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
